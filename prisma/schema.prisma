// Mergeport schema.
// Concepts kept separate on purpose: Workspace, Project (app concept), GithubOwner (GitHub account),
// Repository (GitHub repo), Member (dashboard member), RepositoryGrant, GithubConnection.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Exactly one OWNER per workspace (partial unique index Member_one_owner). READER is read-only. See docs/roles.md.
enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  READER
}

enum MemberStatus {
  ACTIVE
  REVOKED
}

enum OwnerType {
  USER
  ORGANIZATION
  UNKNOWN
}

enum Visibility {
  PUBLIC
  PRIVATE
  INTERNAL
  UNKNOWN
}

enum TrackingStatus {
  ACTIVE
  DISCONNECTED
  REMOVED
}



enum WorkItemType {
  ISSUE
  PULL_REQUEST
}

enum WorkItemState {
  OPEN
  CLOSED
  MERGED
}

enum ChecksState {
  NONE
  PENDING
  SUCCESS
  FAILURE
  UNKNOWN
}

enum MergeableState {
  MERGEABLE
  CONFLICTING
  UNKNOWN
}

enum CommentKind {
  ISSUE_COMMENT
  REVIEW_COMMENT
  REVIEW
  EVENT
}

enum ReviewState {
  APPROVED
  CHANGES_REQUESTED
  COMMENTED
  DISMISSED
  PENDING
}

enum RuleScope {
  REPOSITORY
  OWNER
  PROJECT
  WORKSPACE
}

enum ApprovalSemantics {
  ANY
  ALL
}

enum ReviewerKind {
  USER
  TEAM
  EXTERNAL_ROLE
}

enum WaitingStatus {
  PENDING
  SATISFIED
  CANCELLED
  STALE
}

enum WaitingSource {
  RULE
  MANUAL
}


enum UpstreamEvidence {
  ANCESTRY_EXACT
  PATCH_EQUIVALENT_POSSIBLE
  MANUAL_ACK
  NOT_DETECTED
  UNKNOWN
}

enum TriageStatus {
  UNTRIAGED
  WATCHING
  RELEVANT
  ADDRESSED
  IGNORED
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  /// Owners and administrators let people write to GitHub as themselves (create an issue from a task, comment). Off by default; only has effect while the deployment allows it (MERGEPORT_GITHUB_WRITES=on).
  githubWritesEnabled Boolean @default(false)

  sessions      Session[] @relation("SessionActiveWorkspace")
  members       Member[]
  projects      Project[]
  repositories  Repository[]
  reviewRules   ReviewRule[]
  waitingRules WaitingRule[]
  milestones    DashboardMilestone[]
  audit         AuditLog[]
  notifications Notification[]
  waitingRecords WaitingRecord[]
  reviewerAvailability ReviewerAvailability[]
  labelMaps     LabelMap[]
  upstreamSubscriptions UpstreamSubscription[]
  spaces        Space[]
  invitations   Invitation[]
  accessSpaces  AccessSpace[]
  teamConfig    TeamConfig?
  hubSession    HubSession?
  aiSettings    AiSettings?
  aiSuggestions AiSuggestion[]
  aiPendingActions AiPendingAction[]
  dailyDigests  DailyDigest[]
  gitCache      GitCache[]
  discoveryCache DiscoveryCache[]
  jobs          Job[]
  installations WorkspaceInstallation[]
  githubAppStates GithubAppState[]
  apiTokens ApiToken[]
  oauthGrants OAuthGrant[]
  oauthCodes OAuthCode[]
  oauthRefreshes OAuthRefresh[]
  federationPolicy FederationPolicy?
  federationLinks  FederationLink[]
  federationGrants FederationGrant[]
  federationCache  FederationCache[]
  federationEvents FederationEvent[]
}

model User {
  id        String   @id @default(cuid())
  githubId  BigInt?  @unique // null for people who signed in with email or OIDC and have not linked GitHub
  /// The GitHub login of the linked account, set when the person links GitHub and refreshed whenever their GitHub token is used. Null for legacy local users whose githubId came from `gh` (their `login` is the GitHub login).
  githubLogin String?
  login     String
  name      String?
  avatarUrl String?
  timezone  String   @default("UTC")
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  /// Always stored lowercased. Null for legacy GitHub users. Unique when present (Postgres allows many NULLs).
  email           String?   @unique
  /// Set when the person proved they own `email` (magic link opened, or an OIDC provider asserted email_verified).
  emailVerifiedAt DateTime?

  identities    Identity[]
  members       Member[]
  sessions      Session[]
  devices       Device[]
  savedFilters  SavedFilter[]
  notifications Notification[]
  connectedInstallations WorkspaceInstallation[] @relation("WorkspaceInstallationConnectedBy")
  federationLinks  FederationLink[]
  federationGrants FederationGrant[]
  githubUserToken  GithubUserToken?
  githubRepoAccess GithubRepoAccess[]
  apiTokens ApiToken[]
  oauthGrants OAuthGrant[]
  oauthCodes OAuthCode[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  csrfToken String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  /// The workspace this login works in. Checked against an ACTIVE membership on every request; null means "pick the default".
  activeWorkspaceId String?

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation("SessionActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeWorkspaceId])
}

/// How a person proves who they are. provider: 'email' | 'github' | 'oidc:<name>'; subject: the lowercased email, GitHub id or OIDC `sub`.
model Identity {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  subject   String
  email     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

/// One emailed sign-in link. Only the SHA-256 of the token is stored. Single use (consumedAt), 15 minutes.
model MagicLink {
  id              String    @id @default(cuid())
  emailLowercased String
  tokenHash       String    @unique
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  consumedAt      DateTime?
  ipHash          String?
  /// SHA-256 of the random value kept in the requesting browser's cookie. The link only works in that browser (login CSRF, mail scanners).
  browserHash     String?

  @@index([emailLowercased, createdAt])
  @@index([expiresAt])
}

model Member {
  id          String       @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole   @default(MEMBER)
  status      MemberStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants          RepositoryGrant[]
  projects        ProjectMember[]
  planningCreated PlanningItem[]      @relation("PlanningCreatedBy")
  ownedMilestones DashboardMilestone[]
  invitationsSent Invitation[]
  accessSpaces    AccessSpaceMember[]

  @@unique([workspaceId, userId])
}



model GithubOwner {
  id        String    @id @default(cuid())
  githubId  BigInt    @unique
  login     String
  type      OwnerType @default(UNKNOWN)
  avatarUrl String?
  synthetic Boolean   @default(false)

  repositories Repository[]
}

model Repository {
  id             String         @id @default(cuid())
  workspaceId    String
  githubId       BigInt
  ownerId        String
  name           String
  fullName       String
  htmlUrl        String
  description    String?
  visibility     Visibility     @default(UNKNOWN)
  isFork         Boolean        @default(false)
  parentGithubId BigInt?
  parentFullName String?
  defaultBranch  String?
  archived       Boolean        @default(false)
  permissions    Json? // permissions of the credential that last saw it
  trackingStatus TrackingStatus @default(ACTIVE)
  /// When a verified webhook last named this repository (at most once a minute). Lets the reconcile run less often while events arrive.
  lastEventAt    DateTime?
  statusDetail   String?
  isDemo         Boolean        @default(false)
  spaceId        String? // coordination space that declares (shares) this repository; null = local only
  /// GitHub App installation that grants access to this repository; null for local `gh` and demo repositories.
  installationId BigInt?
  lastSyncedAt   DateTime?
  syncError      String?
  rateLimited    Boolean        @default(false)
  createdAt      DateTime       @default(now())

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       GithubOwner        @relation(fields: [ownerId], references: [id])
  /// Binding that serves this repository. MATCH SIMPLE: a null installationId is unchecked. NO ACTION is checked at the end of the statement, so deleting a workspace (which cascades to both tables) still works.
  installation WorkspaceInstallation? @relation(fields: [workspaceId, installationId], references: [workspaceId, installationId], onDelete: NoAction, onUpdate: NoAction)
  projects    ProjectRepository[]
  grants      RepositoryGrant[]
  workItems   WorkItem[]
  branches    Branch[]
  reviewRules ReviewRule[]
  waitingRules WaitingRule[]
  milestoneLinks MilestoneRepoLink[]
  forkMappings   ForkMapping[] @relation("ForkSide")
  upstreamOf     ForkMapping[] @relation("UpstreamSide")
  snapshots      WorktreeSnapshot[]
  deviceMappings DeviceRepoMapping[]

  @@unique([workspaceId, githubId])
  @@index([workspaceId, trackingStatus])
  @@index([installationId])
}


model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  spaceId     String? // null = local only
  /// The access-control space this project lives in (who may see and write it). Null = the workspace's COMMON space.
  accessSpaceId String?
  /// off | suggest. Suggestions never move anything by themselves and never write to GitHub.
  automation  String   @default("off")
  createdAt   DateTime @default(now())

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accessSpace  AccessSpace?        @relation(fields: [accessSpaceId], references: [id], onDelete: SetNull)
  boards       PlanBoard[]
  epics        Epic[]
  iterations   Iteration[]
  events       PlanEvent[]
  repositories ProjectRepository[]
  members      ProjectMember[]
  columns      PlanningColumn[]
  items        PlanningItem[]
  milestones   DashboardMilestone[]
  reviewRules  ReviewRule[]
  waitingRules WaitingRule[]

  @@unique([workspaceId, slug])
  @@index([accessSpaceId])
}

/// Who sees and writes a group of projects. Separate from Space (the GitHub/hub sync space, scheduled for removal).
/// COMMON: every active member reads it; one per workspace (partial unique index). RESTRICTED: only AccessSpaceMember rows.
model AccessSpace {
  id          String    @id @default(cuid())
  workspaceId String
  kind        SpaceKind
  name        String
  createdAt   DateTime  @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   AccessSpaceMember[]
  projects  Project[]

  @@index([workspaceId])
}

model AccessSpaceMember {
  spaceId  String
  memberId String
  canWrite Boolean @default(false)

  space  AccessSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  member Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([spaceId, memberId])
  @@index([memberId])
}

/// An email invitation to join a workspace. The token is only stored as its SHA-256. At most one pending (not accepted, not revoked)
/// row per (workspaceId, emailLowercased): partial unique index Invitation_pending_key. The role is never OWNER (CHECK constraint).
model Invitation {
  id                String    @id @default(cuid())
  workspaceId       String
  emailLowercased   String
  role              MemberRole
  invitedByMemberId String?
  tokenHash         String    @unique
  expiresAt         DateTime
  acceptedAt        DateTime?
  revokedAt         DateTime?
  /// Set when the last attempt to mail the invitation failed (cleared by a successful send); the members page then offers Resend.
  sendFailedAt      DateTime?
  createdAt         DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy Member?   @relation(fields: [invitedByMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model ProjectRepository {
  projectId    String
  repositoryId String

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([projectId, repositoryId])
}

model ProjectMember {
  projectId String
  memberId  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
}

model RepositoryGrant {
  id           String    @id @default(cuid())
  memberId     String
  repositoryId String
  canManageWork Boolean  @default(false)
  canReview    Boolean   @default(false)
  grantedById  String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([memberId, repositoryId])
  @@index([repositoryId])
}

model WorkItem {
  id             String         @id @default(cuid())
  repositoryId   String
  githubId       BigInt
  number         Int
  type           WorkItemType
  title          String
  body           String?
  state          WorkItemState  @default(OPEN)
  draft          Boolean        @default(false)
  authorLogin    String?
  authorGithubId BigInt?
  authorAvatar   String?
  labels         Json           @default("[]") // [{name,color}]
  assignees      Json           @default("[]") // [login]
  labelNames     String         @default("") // "|bug|docs|" lowercase search index of labels (SQLite cannot filter JSON arrays)
  assigneeLogins String         @default("") // "|alice|bob|" lowercase search index of assignees
  assigneeIds    String         @default("") // "|123|456|" numeric GitHub ids of the assignees; empty = not recorded (older row, local or demo item), then logins decide
  milestoneNumber Int?
  milestoneTitle String?
  htmlUrl        String
  headSha        String?
  headRef        String?
  baseRef        String?
  mergeable      MergeableState @default(UNKNOWN)
  checksState    ChecksState    @default(NONE)
  additions      Int?
  deletions      Int?
  changedFiles   Int?
  createdAtGh    DateTime
  updatedAtGh    DateTime // source-of-truth timestamp used to reject stale writes
  closedAtGh     DateTime?
  mergedAtGh     DateTime?
  syncedAt       DateTime       @default(now())

  repository      Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  comments        WorkItemComment[]
  reviewRequests  ReviewRequest[]
  waiting         WaitingRecord[]
  planningItems   PlanningItem[]

  @@unique([repositoryId, number])
  @@unique([repositoryId, githubId])
  @@index([repositoryId, state, type])
}

model WorkItemComment {
  id         String      @id @default(cuid())
  workItemId String
  githubId   BigInt
  kind       CommentKind
  authorLogin String?
  authorGithubId BigInt? // numeric id of the commenter/reviewer; null = not recorded, then the login decides
  body       String?
  reviewState ReviewState?
  commitSha  String?
  path       String?
  line       Int?
  threadKey  String?
  /// Whether GitHub marks this review thread resolved. Null means it was never read, which is not the same as unresolved.
  threadResolved Boolean?
  createdAtGh DateTime
  updatedAtGh DateTime

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@unique([workItemId, kind, githubId])
  @@index([workItemId, createdAtGh])
}

model ReviewRequest {
  id           String       @id @default(cuid())
  workItemId   String
  kind         ReviewerKind
  reviewerRef  String // login or team slug
  reviewerGithubId BigInt? // numeric id of a requested USER; null = not recorded (older row, local or demo), then the login decides
  requestedAt  DateTime
  removedAt    DateTime?

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId])
}

model Branch {
  id           String   @id @default(cuid())
  repositoryId String
  name         String
  sha          String
  isDefault    Boolean  @default(false)
  fetchedAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
}

/// "Everything that matches waits on these people until it is merged or closed", independent of review requests: for work
/// that sits with someone else (for example every open pull request in a repository whose maintainer merges). Nothing is
/// built in; every rule is data the person writes.
model WaitingRule {
  id            String    @id @default(cuid())
  workspaceId   String
  scope         RuleScope
  repositoryId  String?
  ownerLogin    String?
  projectId     String?
  itemType      String    @default("PULL_REQUEST") // PULL_REQUEST | ISSUE | ANY
  labels        Json      @default("[]") // string[]; empty = any
  authors       Json      @default("[]") // logins; empty = any author
  includeDrafts Boolean   @default(false)
  waitingOn     Json // [{kind:USER|TEAM|EXTERNAL_ROLE, ref}]
  reason        String
  /// INTERNAL_REVIEW | EXTERNAL_REVIEW | MAINTAINER_MERGE | UPSTREAM_RELEASE, or empty to infer from who is waited on.
  stage         String    @default("")
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope])
}

model ReviewRule {
  id          String            @id @default(cuid())
  workspaceId String
  scope       RuleScope
  repositoryId String?
  ownerLogin  String?
  projectId   String?
  labels      Json              @default("[]") // string[] (SQLite has no scalar lists)
  reviewers   Json // [{kind:USER|TEAM|EXTERNAL_ROLE, ref, display?}]
  semantics   ApprovalSemantics @default(ANY)
  reason      String
  enabled     Boolean           @default(true)
  createdAt   DateTime          @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope])
}

model WaitingRecord {
  id             String        @id @default(cuid())
  workspaceId    String
  workItemId     String?
  planningItemId String?
  source         WaitingSource
  ruleId         String?
  reviewerKind   ReviewerKind
  reviewerRef    String
  reason         String
  stage          String        @default("")
  status         WaitingStatus @default(PENDING)
  startedAt      DateTime      @default(now())
  clearedAt      DateTime?
  clearedById    String?
  clearReason    String?

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItem     WorkItem?     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  planningItem PlanningItem? @relation(fields: [planningItemId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workItemId])
}

model PlanningColumn {
  id        String @id @default(cuid())
  projectId String
  key       String
  name      String
  position  Int

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   PlanningItem[]

  @@unique([projectId, key])
}

model PlanningItem {
  id           String   @id @default(cuid())
  projectId    String
  columnId     String
  position     Float
  version      Int      @default(1) // optimistic concurrency
  title        String // used when workItemId is null (internal draft task)
  description  String?
  workItemId   String? // GitHub issue/PR link; inherits repository restrictions
  workRepoGithubId BigInt? // stable reference to the linked work item, resolved to workItemId after source sync
  workNumber   Int?
  assigneeLogin String?
  assignedByLogin String? // who last set the assignee (GitHub login, so it reads right on every computer)
  authorLogin  String? // who created the task (GitHub login)
  labels       Json     @default("[]") // [string]
  priority     Int      @default(0)
  dueDate      DateTime?
  milestoneId  String?
  epicId       String?
  iterationId  String?
  /// A local branch name this card is worked on in; matched against the branch/worktree snapshot on this computer.
  branchRef    String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column    PlanningColumn       @relation(fields: [columnId], references: [id], onDelete: NoAction)
  workItem  WorkItem?            @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  milestone DashboardMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy Member               @relation("PlanningCreatedBy", fields: [createdById], references: [id], onDelete: NoAction)
  blocks    PlanningLink[]       @relation("LinkFrom")
  blockedBy PlanningLink[]       @relation("LinkTo")
  waiting   WaitingRecord[]
  comments  TaskComment[]
  checklist TaskCheckItem[]

  @@index([projectId, columnId])
  @@index([assigneeLogin])
  @@index([epicId])
  @@index([iterationId])
}

/// Immutable GitHub answers keyed by commit (diffs, file contents, commit lists), so reopening a pull request or a file costs
/// nothing. Safe to delete at any time; it is rebuilt on demand and pruned by age and size.
model GitCache {
  workspaceId String
  key        String
  payload    Json
  bytes      Int
  createdAt  DateTime @default(now())
  accessedAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
  @@index([accessedAt])
}

/// One checkbox on a task. One row (and one synced file) per item, so two people ticking different items never conflict.
model TaskCheckItem {
  id          String    @id @default(cuid())
  itemId      String
  text        String
  done        Boolean   @default(false)
  position    Float
  doneByLogin String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  item PlanningItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
}

/// A comment on a task, or a short system line ("assigned to alice"). One row per entry so two people never edit the same file.
model TaskComment {
  id          String    @id @default(cuid())
  itemId      String
  authorLogin String
  kind        String    @default("COMMENT") // COMMENT | EVENT
  body        String
  createdAt   DateTime  @default(now())
  editedAt    DateTime?

  item PlanningItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model PlanningLink {
  fromId String // blocker (or the first item of a related / duplicate pair)
  toId   String // blocked
  /// blocks | related | duplicates. Only "blocks" holds work back and is cycle-checked.
  kind   String @default("blocks")

  from PlanningItem @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   PlanningItem @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
}

model DashboardMilestone {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  description String?
  ownerId     String?
  startDate   DateTime?
  targetDate  DateTime?
  status      String    @default("OPEN")
  /// Work finished is not the same as released: shipping is recorded separately, with an optional tag and link.
  releaseTag  String?
  releaseUrl  String?
  shippedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner     Member?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  items     PlanningItem[]
  repoLinks MilestoneRepoLink[]

  @@index([workspaceId])
}

model MilestoneRepoLink {
  milestoneId     String
  repositoryId    String
  githubMilestoneNumber Int

  milestone  DashboardMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  repository Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([milestoneId, repositoryId])
}

model ForkMapping {
  id             String  @id @default(cuid())
  backports      BackportRecord[]
  forkRepoId     String
  upstreamRepoId String
  forkBranch     String
  upstreamBranch String

  fork     Repository @relation("ForkSide", fields: [forkRepoId], references: [id], onDelete: Cascade)
  upstream Repository @relation("UpstreamSide", fields: [upstreamRepoId], references: [id], onDelete: Cascade)
  comparisons ForkComparison[]
  upstreamPrs UpstreamPrState[]
  triage      UpstreamIssueTriage[]
  updateConfig UpstreamUpdateConfig?
  updateRuns   UpstreamUpdateRun[]

  @@unique([forkRepoId, upstreamRepoId, forkBranch, upstreamBranch])
}

/// Per-mapping settings of the upstream auto-updater. LOCAL ONLY: `verifyCommand` runs on this computer, so this table is never
/// written to a space, a hub or a backup, and a restore never imports it.
model UpstreamUpdateConfig {
  id            String    @id @default(cuid())
  mappingId     String    @unique
  enabled       Boolean   @default(false)
  verifyCommand String?
  /// pr | push
  promote       String    @default("pr")
  timeoutSec    Int       @default(1200)
  branchName    String    @default("mergeport/upstream-sync")
  lastRunAt     DateTime?
  updatedAt     DateTime  @default(now()) @updatedAt
  /// merge | releases. `releases` never uses git, the verify command or `promote`: it only reads the upstream's releases and warns.
  mode               String    @default("merge")
  includePrereleases Boolean   @default(false)
  /// The first check after the mode is switched on only records the newest release (no warning for history).
  releasesBaselined  Boolean   @default(false)
  lastReleaseId      String?
  lastReleaseTag     String?
  lastReleaseAt      DateTime?
  releasesEtag       String?
  releasesCheckedAt  DateTime?
  /// What the person approved when they saved: a mapping or repository changed since (a teammate's shared edit, a rename) stops the
  /// updater until they save again. Null only for a row never saved through the settings (pinned on its first run).
  pinForkGithubId     BigInt?
  pinUpstreamGithubId BigInt?
  pinForkFullName     String?
  pinUpstreamFullName String?
  pinForkBranch       String?
  pinUpstreamBranch   String?

  mapping ForkMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)
}

/// One attempt of the upstream auto-updater for a mapping (its history is what the Forks page shows).
model UpstreamUpdateRun {
  id             String    @id @default(cuid())
  mappingId      String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  /// running | promoted | pr-opened | up-to-date | conflict | verify-failed | failed | cancelled | merged-untested | release-found
  state          String    @default("running")
  /// auto | manual
  trigger        String    @default("auto")
  /// Upstream head the run started from (the newest it knew), and the fork tip it merged onto.
  upstreamSha    String?
  forkSha        String?
  triedShas      Json
  prUrl          String?
  filesConflicted Json?
  commits        Json
  logTail        String    @default("")
  error          String?
  /// release-found only: the upstream release id (never warned twice), what it said, and when the person first looked at it.
  releaseId      String?
  release        Json?
  seenAt         DateTime?

  mapping ForkMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@index([mappingId, startedAt])
  @@index([mappingId, releaseId])
}

model ForkComparison {
  id         String   @id @default(cuid())
  mappingId  String
  status     String // identical | ahead | behind | diverged | unrelated | unknown | error
  aheadBy    Int?
  behindBy   Int?
  baseSha    String? // upstream tip at compare time
  headSha    String? // fork tip at compare time
  truncated  Boolean  @default(false)
  error      String?
  comparedAt DateTime @default(now())

  mapping ForkMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@index([mappingId, comparedAt])
}

model UpstreamPrState {
  id          String           @id @default(cuid())
  mappingId   String
  number      Int
  title       String
  state       String // open | merged | closed
  htmlUrl     String
  mergeSha    String?
  mergedAtGh  DateTime?
  evidence    UpstreamEvidence @default(UNKNOWN)
  evidenceNote String?
  ackedById   String?

  mapping ForkMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, number])
}

model UpstreamIssueTriage {
  id           String       @id @default(cuid())
  mappingId    String
  issueNumber  Int
  title        String
  htmlUrl      String
  status       TriageStatus @default(UNTRIAGED)
  linkedWorkItemId String?
  note         String?
  decidedById  String?
  updatedAt    DateTime     @updatedAt

  mapping ForkMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, issueNumber])
}

/// "This computer". Worktree scanning is local: the app runs on the machine that has the folders.
model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roots     DeviceRepoMapping[]
  snapshots WorktreeSnapshot[]
}

model DeviceRepoMapping {
  id           String @id @default(cuid())
  deviceId     String
  repositoryId String
  rootPath     String? // absolute path chosen by the person; never leaves this machine

  device     Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([deviceId, repositoryId])
}

model WorktreeSnapshot {
  id           String   @id @default(cuid())
  deviceId     String
  repositoryId String
  capturedAt   DateTime
  data         Json // {worktrees:[{path,branch,head,detached,locked,prunable,dirty:{...},tracking,aheadBehind}]}

  device     Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([deviceId, repositoryId])
}

model SavedFilter {
  id     String @id @default(cuid())
  userId String
  scope  String
  name   String
  query  String
  /// A shared view is synchronised as a definition only; every viewer's results are computed under their own access.
  shared     Boolean @default(false)
  ownerLogin String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  repositoryId String? // authorization context: filtered by current grants at read time
  kind        String
  title       String
  href        String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  /// When a Windows toast was shown for it (or it was skipped for one: not wanted, already shown by an open tab, too old). Null = still to decide.
  toastedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([workspaceId, userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Job {
  id          String    @id @default(cuid())
  /// Null only for system-wide jobs that serve no single tenant (see docs/tenancy.md); every per-workspace job carries it.
  workspaceId String?
  type        String
  payload     Json
  dedupeKey   String?   @unique
  intervalMs  Int? // recurring job: re-queued by the runner after every run
  dirty       Boolean   @default(false) // a trigger arrived while the job was RUNNING: run again right after
  status      JobStatus @default(QUEUED)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([workspaceId])
}


model PublicCacheEntry {
  key       String   @id
  etag      String?
  body      Json
  fetchedAt DateTime @default(now())
  /// Stored body size, so retention (src/lib/github/cache-prune.ts) can sum and evict without reading bodies.
  bytes     Int      @default(0)

  @@index([fetchedAt, bytes])
}

/// Last known result of a network discovery (repositories, invitations, space candidates), so pages render from local
/// state. `fetchedAt` is the last SUCCESSFUL fetch and stays put while later attempts fail.
model DiscoveryCache {
  workspaceId String
  key         String // "repos" | "invitations" | "candidates" | "inv-status:<spaceId>"
  payload     Json?
  fetchedAt   DateTime?
  state       String    @default("EMPTY") // EMPTY | FRESH | RETRYING | OFFLINE | AUTH | RATE_LIMITED | ERROR
  error       String?
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
}

model RateLimitState {
  key       String   @id // e.g. "public-ip", "installation:123"
  remaining Int
  limit     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

enum SpaceKind {
  COMMON
  RESTRICTED
}

enum SpaceAccess {
  OK
  REVOKED
  NO_ACCESS
  SCHEMA_NEWER
}

enum OpKind {
  UPSERT
  DELETE
}

enum OpStatus {
  PENDING
  SENT
  CONFLICT
  QUARANTINED
  FAILED
}

enum TeamMode {
  PERSONAL
  TEAM
}

enum SpaceBackend {
  GITHUB
  HUB
}

enum TeamBackend {
  GITHUB
  HUB
}

/// A coordination space = one private GitHub repository with exactly one audience (its collaborators).
model Space {
  id             String      @id @default(cuid())
  workspaceId    String
  remoteId       String // spaceId from the manifest
  teamRemoteId   String
  kind           SpaceKind
  name           String
  repoOwner      String
  repoName       String
  repoGithubId   BigInt?
  branch         String      @default("main")
  /// Taken from GitHub's permissions for THIS account, never from a role string in the repository.
  canWrite       Boolean     @default(false)
  canAdmin       Boolean     @default(false)
  access         SpaceAccess @default(OK)
  headSha        String?
  etag           String? // conditional head check
  lastPolledAt   DateTime?
  lastChangedAt  DateTime?
  pollIntervalMs Int         @default(30000)
  unchangedPolls Int         @default(0)
  nextPollAt     DateTime?
  lastError      String?
  rateLimitedUntil DateTime?
  /// Entities seen but not applicable yet (a referenced source item is not synchronised here). While above zero, an unchanged head is re-read.
  deferredCount  Int         @default(0)
  /// Last time this computer published to the space. Teammates only see it on their next poll.
  lastPushedAt   DateTime?
  createdAt      DateTime    @default(now())
  backend        SpaceBackend @default(GITHUB)
  /// Hub space id (empty for GitHub spaces).
  hubSpaceId     String      @default("")
  /// Last hub change sequence applied locally.
  hubCursor      BigInt      @default(0)
  /// The op the hub recorded at hubCursor: lets the hub tell that its history is no longer the one this cursor points into (a restore).
  hubCursorOp    String      @default("")
  /// The hub process this cursor was read from. A different one may be serving a restored database.
  hubEpoch       String      @default("")
  /// Hub entities the cursor moved past that could not be applied yet (a related entity was missing, or applying failed), retried on later pulls
  /// a bounded number of times; entries marked `gaveUp` are only kept as a visible note until the entity changes again.
  hubDeferred    Json?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  restores  HubRestore[]
  entities  SyncEntity[]
  outbox    OutboxOp[]
  conflicts SyncConflict[]

  @@unique([workspaceId, backend, repoOwner, repoName, hubSpaceId])
}

/// What we last agreed on with the remote for one entity file: enables 3-way merges.
model SyncEntity {
  spaceId     String
  type        String
  entityId    String
  path        String
  remoteSha   String?
  baseVersion Int     @default(0)
  baseData    Json?
  meta        Json? // { applied: string[] } recent operation ids already in the remote file
  deleted     Boolean @default(false)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, type, entityId])
}

/// Durable local outbox. Rows are written BEFORE any network call.
model OutboxOp {
  id          String   @id // idempotent operation id
  spaceId     String
  entityType  String
  entityId    String
  kind        OpKind
  data        Json?
  baseVersion Int      @default(0)
  status      OpStatus @default(PENDING)
  attempts    Int      @default(0)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
}

model SyncConflict {
  id            String    @id @default(cuid())
  spaceId       String
  entityType    String
  entityId      String
  fields        Json // string[] of conflicting keys
  base          Json
  local         Json
  remote        Json
  remoteVersion Int
  opId          String?
  status        String    @default("OPEN") // OPEN | RESOLVED
  resolution    String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
}

/// The hub's history stopped being the one this computer had followed (restored from a backup). What the hub's state replaced is kept here.
model HubRestore {
  id         String   @id @default(cuid())
  spaceId    String
  at         DateTime @default(now())
  /// Entities whose local copy was newer than the restored hub (or absent from it) and were replaced by the hub's state.
  rolledBack Int
  /// Entities with unsent local edits: these were kept and merged against the restored state.
  kept       Int
  /// [{ type, entityId, deleted, data }]: the local copies that were replaced (capped).
  detail     Json
  status     String   @default("OPEN") // OPEN | RESENT | DISMISSED
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
}

model TeamConfig {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  mode          TeamMode @default(PERSONAL)
  teamRemoteId  String?
  name          String?
  ownerLogin    String?
  commonSpaceId String?
  pollSeconds   Int      @default(30)
  /// Repository watcher (repo-watch.ts). watchSeconds NULL = not set here, so MERGEPORT_WATCH_SECONDS or 15 applies.
  watchSeconds  Int?
  watchEnabled  Boolean  @default(true)
  /// NULL = not set here: MERGEPORT_WATCH_MAX_REPOS or 20.
  watchMaxRepos Int?
  backend       TeamBackend @default(GITHUB)
  hubOrigin     String?
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// The one hub login of this client; `cipher` is the encrypted hub session token.
model HubSession {
  id        String   @id @default(cuid())
  workspaceId String @unique
  origin    String
  cipher    String
  githubId  BigInt
  login     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Personal inbox state per item. Never synchronised: what you have read, finished or snoozed is yours alone.
/// Each marker stores the "version" of the item it was set against; a newer version (a new review request, commit or comment) reopens it.
model InboxState {
  userId        String
  subjectType   String // "work-item"
  subjectId     String
  readVersion   String?
  doneVersion   String?
  snoozeUntil   DateTime?
  snoozeVersion String?
  updatedAt     DateTime  @default(now()) @updatedAt

  @@id([userId, subjectType, subjectId])
}

/// What a person last looked at on an item, to show "since you last looked". Personal and never synchronised.
model SeenState {
  userId     String
  workItemId String
  snapshot   Json
  seenAt     DateTime @default(now()) @updatedAt

  @@id([userId, workItemId])
}

/// Who is unavailable and who covers for them. Shared team configuration: it suggests a backup, it never reassigns anything.
model ReviewerAvailability {
  id               String    @id @default(cuid())
  workspaceId      String
  login            String // lower case
  unavailableFrom  DateTime?
  unavailableUntil DateTime?
  backupLogin      String?
  note             String?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, login])
}

/// Personal notification preferences (JSON). Never synchronised.
model NotificationPref {
  userId    String   @id
  prefs     Json
  updatedAt DateTime @default(now()) @updatedAt
}

/// A named view of a project's cards: which columns, in what order, with what labels and optional work-in-progress limits.
/// Boards never copy cards; they show the same planning items. WIP limits are advice (a column over its limit is flagged, not locked).
model PlanBoard {
  id        String   @id @default(cuid())
  projectId String
  name      String
  template  String   @default("")
  /// [{ key, name?, wip? }] where key is a column key of the project.
  columns   Json
  /// none | repository | assignee | milestone | epic
  groupBy   String   @default("none")
  density   String   @default("comfortable")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A shallow parent of cards (and linked GitHub issues): one level, no epics inside epics.
model Epic {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  ownerLogin  String?
  startDate   DateTime?
  targetDate  DateTime?
  status      String    @default("OPEN") // OPEN | DONE
  decisions   String?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A short timebox. A milestone is the delivery goal; an iteration is the cycle currently funding part of it.
model Iteration {
  id        String    @id @default(cuid())
  projectId String
  name      String
  startDate DateTime
  endDate   DateTime
  closedAt  DateTime?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Append-only planning history (created, moved, milestone/iteration/epic changes, carry-overs). Analytics read only this table.
model PlanEvent {
  id         String   @id @default(cuid())
  projectId  String
  itemId     String
  kind       String
  fromKey    String?
  toKey      String?
  refId      String?
  actorLogin String?
  at         DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, at])
  @@index([itemId])
}

/// A pending review being assembled on this computer. Personal: it is only sent to GitHub when the person submits it.
model ReviewDraft {
  id         String   @id @default(cuid())
  userId     String
  workItemId String
  path       String
  line       Int
  side       String   @default("RIGHT")
  body       String
  commitSha  String
  createdAt  DateTime @default(now())

  @@index([userId, workItemId])
}

/// Which files a person has viewed, with a signature of their content then. A file whose content changed shows as unviewed again.
model ViewedFile {
  userId     String
  workItemId String
  path       String
  sig        String
  viewedAt   DateTime @default(now())

  @@id([userId, workItemId, path])
}

/// "This spelling means this concept" (for example P1 means priority::high), globally or for one repository. Reading only: labels on GitHub are never rewritten.
model LabelMap {
  id          String   @id @default(cuid())
  workspaceId String
  concept     String
  spelling    String
  /// Repository id, or empty for every repository.
  repoKey     String   @default("")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, spelling, repoKey])
}

/// Saved interest in upstream changes: any criterion that hits makes an upstream item relevant, with the reason shown.
model UpstreamSubscription {
  id          String   @id @default(cuid())
  workspaceId String
  mappingId   String?
  name        String
  criteria    Json
  muted       Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// An explicit record that an upstream change is being (or was) brought to a branch. Evidence is kept apart from the person's decision.
model BackportRecord {
  id             String   @id @default(cuid())
  mappingId      String
  upstreamNumber Int
  targetBranch   String
  /// planned | done
  state          String   @default("planned")
  /// ancestry | patch-equivalent | manual | unknown
  evidence       String   @default("unknown")
  localSha       String?
  note           String?
  byLogin        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  mapping ForkMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([mappingId, upstreamNumber, targetBranch])
}

/// One generated daily digest per person and local day (day = the day reported, the previous local day). Built from this computer's own data, personal, never synchronised.
model DailyDigest {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  day         String // YYYY-MM-DD in the person's time zone
  payload     Json
  generatedAt DateTime  @default(now())
  readAt      DateTime?
  /// Fingerprint of the repositories the person could see when this digest was made. A stored digest is served only while it still matches what they can see now (null: never served).
  visibilityKey String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, day])
}

/// The OpenAI-compatible endpoint used to draft tasks from plain text. One row per profile, never synchronised.
/// `cipher` is the API key encrypted with the profile's vault key (see hub/session-vault.ts). `model` is whatever the endpoint
/// currently offers; it is chosen from the endpoint's own model list and can change at any time.
model AiSettings {
  id        String   @id @default(cuid())
  workspaceId String @unique
  baseUrl   String
  cipher    String?
  model     String?
  /// The model that answered last. With no preferred model it is reused (while still offered) so the server need not swap models.
  lastModel String?
  /// "off" | "suggest" | "create". What the daily background review may do. It never touches GitHub; "create" only makes local tasks for clear cases.
  autopilot String   @default("off")
  lastRunAt DateTime?
  lastRunDay String?
  lastSummary String?
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// A task the AI thinks you should have, from the daily review or "Analyze my workspace". Nothing becomes a task until it is accepted
/// (or the autopilot level is "create" and the case is a clear one). `sourceKey` names the thing it is about, so it is not suggested twice.
model AiSuggestion {
  id        String    @id @default(cuid())
  workspaceId String
  sourceKey String
  title     String
  reason    String
  payload   Json
  /// NEW | ACCEPTED | DISMISSED | AUTO
  state     String    @default("NEW")
  taskId    String?
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state, createdAt])
  @@index([sourceKey])
}

/// A change on GitHub that an AI app (through the MCP server) asked for. It is only a request: nothing is sent until the person
/// approves it in Mergeport, which then performs it as themselves. Local, never synchronised.
model AiPendingAction {
  id         String    @id @default(cuid())
  workspaceId String
  /// comment | request-review | review
  kind       String
  workItemId String
  summary    String
  payload    Json
  /// PENDING | DONE | FAILED | REJECTED
  state      String    @default("PENDING")
  result     String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, state, createdAt])
}

// ---------- Federation (docs/federation.md) ----------
// Every instance is both a consumer (a user links another instance and views its data read-only) and a provider (it owns data and
// issues revocable read-only grants). Nothing here stores a secret in clear: provider tokens and codes are sha256 hashes, consumer
// tokens are AES-256-GCM under MERGEPORT_ENCRYPTION_KEY.

/// Per-workspace linking policy, always inside the operator ceiling (MERGEPORT_FEDERATION). No row = everything off.
model FederationPolicy {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  /// off | allowlist | any
  outboundMode    String   @default("off")
  inboundMode     String   @default("off")
  /// Normalised origins used by the outbound and inbound "allowlist" modes.
  allowlist       String[] @default([])
  /// ADMIN (owner and admins) or MEMBER (members too). READER never links.
  whoCanLink      String   @default("ADMIN")
  maxLinksPerUser Int      @default(5)
  /// Distinct peer instances a workspace may be linked to (0 = none, 1 = a single linked instance).
  maxPeers        Int      @default(5)
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Consumer side: one user's link from this workspace to a peer instance. Visible only to `userId`.
model FederationLink {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String
  peerOrigin        String
  /// AES-256-GCM of the peer's access token. Null while PENDING and after unlinking.
  tokenEnc          String?
  /// PENDING (waiting for the callback) | ACTIVE | REVOKED (unlinked here, revoked by the peer, or refused)
  status            String    @default("PENDING")
  /// sha256 of the OAuth state of a PENDING link (one use), and the encrypted PKCE verifier. Both cleared at the callback.
  stateHash         String?   @unique
  verifierEnc       String?
  pendingExpiresAt  DateTime?
  peerWorkspaceName String?
  peerRole          String?
  lastError         String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  revokedAt         DateTime?

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cache     FederationCache[]

  @@index([workspaceId, userId])
}

/// Provider side: what a user approved for one client instance. Starts as an authorization code, becomes a token on exchange.
model FederationGrant {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String
  clientOrigin      String
  scope             String    @default("read")
  codeHash          String?   @unique
  codeExpiresAt     DateTime?
  codeUsedAt        DateTime?
  codeChallenge     String?
  redirectUri       String?
  /// sha256 of the opaque access token. Null until the code is exchanged.
  tokenHash         String?   @unique
  expiresAt         DateTime?
  absoluteExpiresAt DateTime?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  revokedAt         DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@index([workspaceId, clientOrigin])
}

/// Consumer side: the last answer from a peer for one request key, for one link only (read it only through the link's user).
model FederationCache {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  linkId      String
  key         String
  etag        String?
  bodyJson    Json
  fetchedAt   DateTime

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  link      FederationLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, linkId, key])
}

/// Audit trail of federation decisions. Never holds a token, a code or a verifier.
model FederationEvent {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  kind        String
  peerOrigin  String?
  linkId      String?
  grantId     String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

enum InstallationAccountType {
  USER
  ORGANIZATION
}

enum InstallationRepositorySelection {
  ALL
  SELECTED
}

/// One installation of the deployment's GitHub App on a GitHub account. GLOBAL: the installation id is GitHub-global; the tenant record is WorkspaceInstallation.
model GithubInstallation {
  installationId      BigInt                          @id
  accountGithubId     BigInt
  accountLogin        String
  accountType         InstallationAccountType
  repositorySelection InstallationRepositorySelection @default(SELECTED)
  suspendedAt         DateTime?
  deletedAt           DateTime?
  /// When the last verified webhook for this installation was accepted. Drives the "Live updates" status and the slower reconcile cadence.
  lastWebhookAt       DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  workspaces WorkspaceInstallation[]

  @@index([accountGithubId])
}

/// Which workspaces use which installation (the tenant-side record of a connected GitHub account).
model WorkspaceInstallation {
  id                String   @id @default(cuid())
  workspaceId       String
  installationId    BigInt
  connectedByUserId String?
  /// A row exists only once control of the installation was proved, so these are NOT NULL.
  verifiedAt           DateTime
  /// The GitHub user whose user-to-server token proved control (the installation was in that user's accessible list).
  verifiedGithubUserId BigInt
  /// How it was proved, e.g. `user-installations` (GET /user/installations).
  proofMethod          String
  createdAt         DateTime @default(now())

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation GithubInstallation @relation(fields: [installationId], references: [installationId])
  connectedBy  User?              @relation("WorkspaceInstallationConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  /// Repositories served by this binding. The foreign key is composite and NO ACTION: unbind must null them first (`unbindInstallation`).
  repositories Repository[]

  @@unique([workspaceId, installationId])
  @@index([workspaceId])
  @@index([installationId])
}

/// Webhook delivery ids already handled (replay protection). GLOBAL; pruned by receivedAt. Never holds a payload.
model GithubDelivery {
  deliveryId     String   @id
  installationId BigInt?
  event          String
  receivedAt     DateTime @default(now())

  @@index([receivedAt])
}

/// Short-lived, single-use install / OAuth state, issued to one user for one workspace (ROOT). The state value is `<workspaceId>.<random>`; only its hash is stored.
model GithubAppState {
  id          String    @id @default(cuid())
  stateHash   String    @unique
  userId      String
  workspaceId String
  kind        String
  nonceHash   String?
  expiresAt   DateTime
  usedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([expiresAt])
}

/// "Sign in with GitHub" (docs/github-app.md): the single-use state of a sign-in that has no person or workspace yet. Only hashes are stored. GLOBAL like MagicLink.
model GithubSigninState {
  id        String    @id @default(cuid())
  stateHash String    @unique
  nonceHash String
  /// Where to land after signing in (a relative path, already checked by safeReturnTo).
  next      String    @default("/")
  expiresAt DateTime
  usedAt    DateTime?

  @@index([expiresAt])
}

/// A person's OWN GitHub user-to-server token (hosted, docs/github-app.md "Linking your GitHub account"). GLOBAL like User: one row per person, keyed by `userId`. Both tokens are AES-256-GCM
/// ciphertext (AAD `ghusertoken:<userId>`); the lifetimes come from GitHub's token response. `status` is OK or RELINK (GitHub refused the refresh token: both ciphertexts are then cleared and checks stop until the person links again).
model GithubUserToken {
  id               String    @id @default(cuid())
  userId           String    @unique
  accessEnc        String?
  refreshEnc       String?
  accessExpiresAt  DateTime?
  refreshExpiresAt DateTime?
  status           String    @default("OK")
  /// When the person's repository access was last listed completely from GitHub.
  accessCheckedAt  DateTime?
  /// The last check could not list everything (a page cap) or more repositories than one request can use were found: the person sees access for the first part only.
  accessTruncated  Boolean   @default(false)
  accessRepoCount  Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// What GitHub said one person may open: a repository (GitHub id) reached through one installation, with the person's permission. GLOBAL, keyed by user, never readable across users. Rows older than the validity window grant nothing (fail closed).
model GithubRepoAccess {
  id                 String   @id @default(cuid())
  userId             String
  repositoryGithubId BigInt
  installationId     BigInt
  permission         String
  checkedAt          DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repositoryGithubId])
  @@index([userId, checkedAt])
  @@index([installationId])
}

enum ApiTokenScope {
  READ
  WRITE
}

/// A personal access token for the hosted MCP endpoint (docs/mcp.md). ROOT: bound to ONE workspace and acting as ONE user there; the viewer is loaded fresh for
/// (userId, workspaceId) on every call, so role changes, removal and restricted spaces apply at once. Only the sha256 of the secret is stored (`tokenHash`); `prefix` is the
/// first characters, for display. The secret is shown once, when it is created.
model ApiToken {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  tokenHash   String        @unique
  prefix      String
  scope       ApiTokenScope @default(READ)
  createdAt   DateTime      @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  /// PAT: made by hand in Settings. OAUTH: issued to a connected app (an OAuthGrant), short-lived, bound to `audience` (the /api/mcp address).
  kind        ApiTokenKind  @default(PAT)
  grantId     String?
  audience    String?
  /// WRITE alone means create and comment. Editing, moving and completing (docs/mcp.md) also needs this, set only for tokens made after that power existed. An OAUTH token follows its grant's value.
  editAllowed Boolean       @default(false)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  grant     OAuthGrant? @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@index([grantId])
}

enum ApiTokenKind {
  PAT
  OAUTH
}

/// An app that registered itself (RFC 7591, public client, no secret). GLOBAL: it names no workspace; a person authorizes it for one workspace through an OAuthGrant.
model OAuthClient {
  id           String   @id @default(cuid())
  name         String
  redirectUris Json
  createdAt    DateTime @default(now())

  grants OAuthGrant[]
  codes  OAuthCode[]

  @@index([createdAt])
}

/// One person's consent for one app in ONE workspace (docs/mcp.md, "OAuth"). The family: its access tokens (ApiToken, kind OAUTH) and refresh tokens all hang off it, and revoking it kills them all.
model OAuthGrant {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  clientId    String
  scope       ApiTokenScope @default(READ)
  resource    String
  createdAt   DateTime      @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  /// Same meaning as ApiToken.editAllowed: false for grants made before edit tools existed, true for a WRITE consent given after.
  editAllowed Boolean       @default(false)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    OAuthClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokens    ApiToken[]
  refreshes OAuthRefresh[]

  @@index([workspaceId, userId])
}

/// A single-use authorization code (hash only), 60 seconds, bound to client, redirect address, PKCE challenge, workspace and person.
model OAuthCode {
  id            String        @id @default(cuid())
  codeHash      String        @unique
  workspaceId   String
  userId        String
  clientId      String
  redirectUri   String
  codeChallenge String
  scope         ApiTokenScope
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?
  /// The grant made when the code was used; a replayed code revokes it.
  grantId       String?
  createdAt     DateTime      @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
}

/// A refresh token (hash only), rotated on every use. Using one a second time revokes the whole grant.
model OAuthRefresh {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  workspaceId String
  grantId     String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grant     OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([workspaceId, grantId])
}

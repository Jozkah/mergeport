{
  "name": "mergeport",
  "version": "0.1.0",
  "private": true,
  "description": "Shared GitHub project control center",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "prisma migrate deploy && node --import tsx scripts/start.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "node --import tsx scripts/dev-db.ts",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "node --import tsx scripts/worker.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.63.0",
    "marked": "^16.4.1",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "octokit": "^5.0.5",
    "openid-client": "6.8.8",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.17.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.0",
    "embedded-postgres": "^18.7.0-beta.19",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.5",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10"
  }
}

# Mergeport. See docs/auth.md (hosted sign-in), docs/github-app.md (GitHub App) and docs/mcp.md (MCP).

# REQUIRED: Postgres connection string. `npm run db:dev` starts a native dev Postgres (no Docker) on port 5433 with this URL:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/mergeport"
# Then apply the schema once (and after every pull that adds migrations):  npx prisma migrate deploy
# Using your own Postgres instead? Create an empty database and put its URL above.

# Demo mode: synthetic data, no GitHub access. `npm run demo` sets this for you (see README, "Quick start").
DEMO_MODE="false"

# Port `npm run demo` serves on (loopback only, 127.0.0.1).
MERGEPORT_PORT="3000"

# GitHub host for `gh` (development sign-in without a hosted setup). Default: github.com
MERGEPORT_HOST="github.com"

# Active coordination polling interval in seconds (minimum 15).
MERGEPORT_POLL_SECONDS="30"

# Background jobs run in a separate process: `npm run worker` (any number of workers can share one database).
# `npm start` / `npm run dev` start the web app only, with no job loop.

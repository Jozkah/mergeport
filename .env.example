# Mergeport runs on your own computer. Nothing here is shared with teammates and nothing here is a secret:
# GitHub credentials stay in the GitHub CLI (gh); Mergeport never reads or stores a token.
# Every value is optional. `npm run local` sets what it needs.

# Where per-account profiles (one SQLite database each) live. Default: ~/.mergeport
MERGEPORT_HOME=""

# SQLite file for development without the launcher. Default: ./.data/dev.db
MERGEPORT_DB=""

# Port the launcher serves on (loopback only, 127.0.0.1).
MERGEPORT_PORT="3000"

# GitHub host for `gh`. Default: github.com
MERGEPORT_HOST="github.com"

# Demo mode: synthetic data, no GitHub access. `npm run local:demo` sets this for you.
DEMO_MODE="false"

# Active coordination polling interval in seconds (minimum 15).
MERGEPORT_POLL_SECONDS="30"

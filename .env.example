# Mergeport. GitHub credentials stay in the GitHub CLI (gh); Mergeport never reads or stores a token.

# REQUIRED: Postgres connection string. `npm run db:dev` starts a native dev Postgres (no Docker) on port 5433 with this URL:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/mergeport"
# Then apply the schema once (and after every pull that adds migrations):  npx prisma migrate deploy
# Using your own Postgres instead? Create an empty database and put its URL above.

# Where the launcher keeps per-install side files (credential vault key). Default: ~/.mergeport
MERGEPORT_HOME=""

# Anchor path for the vault key file in development without the launcher. Not a database. Default: ./.data/dev.db
MERGEPORT_DB=""

# Port the launcher serves on (loopback only, 127.0.0.1).
MERGEPORT_PORT="3000"

# GitHub host for `gh`. Default: github.com
MERGEPORT_HOST="github.com"

# Demo mode: synthetic data, no GitHub access. `npm run local:demo` sets this for you.
DEMO_MODE="false"

# Active coordination polling interval in seconds (minimum 15).
MERGEPORT_POLL_SECONDS="30"

# Background jobs run in a separate process: `npm run worker` (any number of workers can share one database).
# `npm start` / `npm run dev` start the web app only, with no job loop. Set to 1 to run the loop inside the web process instead
# (npm run local sets it for you, so the local launcher needs no second process).
MERGEPORT_INLINE_WORKER=""

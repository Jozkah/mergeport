# Mergeport production environment. Copy to .env (never commit it) and fill it in. Operator guide: docs/deploy.md.
# Every value below is a placeholder. Generate secrets with:  openssl rand -hex 32
# Variables marked REQUIRED stop the server at start (hosted mode) or break a feature when missing.

# ---------------------------------------------------------------------------------------------------------------------------
# Core (REQUIRED)
# ---------------------------------------------------------------------------------------------------------------------------

# Public address people use, https, no path. Turns hosted mode on: only this Host is served, the demo and /api/local routes
# disappear, cookies are Secure. ALSO a BUILD argument for the Docker image / Nixpacks build (it is baked into next.config.ts's
# Server Actions allow-list): set it where the image is built, and rebuild if it changes.
MERGEPORT_PUBLIC_URL=https://mergeport.example.com

# Postgres connection string. With docker-compose.yml point it at the bundled service: postgresql://mergeport:<POSTGRES_PASSWORD>@postgres:5432/mergeport. Percent-encode special characters in the password.
DATABASE_URL=postgresql://mergeport:CHANGE_ME@postgres:5432/mergeport

# Password of the bundled postgres service (docker-compose.yml only). Letters and digits keep the DATABASE_URL above simple.
POSTGRES_PASSWORD=CHANGE_ME

# You run behind a reverse proxy that APPENDS the client address to X-Forwarded-For. Without "true" the server refuses to start.
MERGEPORT_TRUST_PROXY=true
# Number of proxies you operate in front of the app (1 to 10, default 1). The client address is the Nth entry from the RIGHT of X-Forwarded-For.
MERGEPORT_TRUSTED_PROXY_HOPS=1

# Where the web process listens. The Docker image sets HOST=0.0.0.0 and PORT=3000 itself; outside Docker the default is 127.0.0.1:3000.
# A non-loopback HOST is refused unless MERGEPORT_PUBLIC_URL is set. MERGEPORT_PORT wins over PORT.
#HOST=0.0.0.0
#PORT=3000
#MERGEPORT_PORT=3000

# Never "true" on a deployment: demo mode serves synthetic data.
DEMO_MODE=false

# ---------------------------------------------------------------------------------------------------------------------------
# Sign-in: email link and/or OpenID Connect (docs/auth.md). Set at least one way in.
# ---------------------------------------------------------------------------------------------------------------------------

# Outgoing mail for sign-in links (nodemailer URL) and the sender address. Both are needed for email sign-in.
SMTP_URL=smtps://smtp-user:CHANGE_ME@smtp.example.com:465
MAIL_FROM=Mergeport <no-reply@mergeport.example.com>

# OpenID Connect, one block per provider NAME (GOOGLE, MICROSOFT, ...). All three or the provider is ignored.
# Redirect URI to register at the provider: <MERGEPORT_PUBLIC_URL>/auth/oidc/<name>/callback (name lowercase).
#OIDC_GOOGLE_ISSUER=https://accounts.google.com
#OIDC_GOOGLE_CLIENT_ID=
#OIDC_GOOGLE_CLIENT_SECRET=
# Microsoft: use the tenant-specific issuer, https://login.microsoftonline.com/<tenant-id>/v2.0
# At least 32 random characters. REQUIRED when any OIDC provider is configured (signs the short-lived flow cookie).
#MERGEPORT_AUTH_SECRET=

# Idle session lifetime in days, 1 to 180 (default 30).
#MERGEPORT_SESSION_DAYS=30
# New workspaces one person may create per day (default 5).
#MERGEPORT_MAX_WORKSPACES_PER_DAY=5

# ---------------------------------------------------------------------------------------------------------------------------
# GitHub App (docs/github-app.md). Without all of it workspaces stay on "GitHub is not connected yet".
# The seven values below are checked together at start: set all or none.
# ---------------------------------------------------------------------------------------------------------------------------
#MERGEPORT_GITHUB_APP_ID=
#MERGEPORT_GITHUB_APP_SLUG=
#MERGEPORT_GITHUB_APP_CLIENT_ID=
#MERGEPORT_GITHUB_APP_CLIENT_SECRET=
# At least 16 characters, no leading or trailing whitespace.
#MERGEPORT_GITHUB_APP_WEBHOOK_SECRET=
# The PEM key, newlines written as \n, OR a path to the PEM file (mount it as a secret). Exactly one of the two.
#MERGEPORT_GITHUB_APP_PRIVATE_KEY=
#MERGEPORT_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem

# Optional GitHub writes (create an issue from a task, comment), made as each person with their linked GitHub account.
# "on" needs MERGEPORT_ENCRYPTION_KEY. Off when unset.
#MERGEPORT_GITHUB_WRITES=off

# ---------------------------------------------------------------------------------------------------------------------------
# Encryption and federation (docs/federation.md)
# ---------------------------------------------------------------------------------------------------------------------------

# At least 32 bytes of key material (64 hex characters recommended). Encrypts stored GitHub user tokens and federation peer tokens.
# REQUIRED when MERGEPORT_GITHUB_WRITES=on or federation is on. Losing or changing it makes those stored tokens unreadable.
#MERGEPORT_ENCRYPTION_KEY=

# Linking between Mergeport instances: off (default), allowlist or any. This is the operator ceiling; workspaces can only narrow it.
#MERGEPORT_FEDERATION=off
# Comma separated origins, used when the ceiling is "allowlist".
#MERGEPORT_FEDERATION_ALLOWLIST=https://other.example.com

# ---------------------------------------------------------------------------------------------------------------------------
# Worker container only
# ---------------------------------------------------------------------------------------------------------------------------

# Set on the worker service: it has no HTTP port, so the image's health check passes. docker-compose.yml sets it for you.
#MERGEPORT_ROLE=worker

# Not for production (refused or ignored when hosted): MERGEPORT_GITHUB_API_BASE, MERGEPORT_GITHUB_WEB_BASE, MERGEPORT_FEDERATION_ALLOW_INSECURE.
# Development only: MERGEPORT_PG_PORT, MERGEPORT_PG_DIR (the embedded dev database, npm run db:dev).
